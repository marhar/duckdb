+// SPIKE helpers: crude string-based JSON field extraction. Sufficient for the
+// well-formed output from gcloud and Google's token endpoint. A real
+// implementation should use yyjson.
+static string SpikeExtractJsonString(const string &json, const string &key) {
+	string needle = "\"" + key + "\"";
+	auto pos = json.find(needle);
+	if (pos == string::npos) {
+		throw IOException("Field '%s' not found in JSON", key);
+	}
+	pos = json.find('"', pos + needle.size());
+	if (pos == string::npos) {
+		throw IOException("Malformed JSON near '%s'", key);
+	}
+	auto end = json.find('"', pos + 1);
+	if (end == string::npos) {
+		throw IOException("Unterminated string for '%s'", key);
+	}
+	return json.substr(pos + 1, end - pos - 1);
+}
+
+static string SpikeUrlEncode(const string &s) {
+	string out;
+	out.reserve(s.size());
+	for (unsigned char c : s) {
+		if (std::isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~') {
+			out += (char)c;
+		} else {
+			char buf[4];
+			std::snprintf(buf, sizeof(buf), "%%%02X", c);
+			out += buf;
+		}
+	}
+	return out;
+}
+
+static string SpikeFetchAccessTokenFromGcloudUserCreds(ClientContext &context) {
+	// 1. Locate ADC file (gcloud user creds path, macOS/Linux convention)
+	const char *home = std::getenv("HOME");
+	if (!home) {
+		throw IOException("HOME env var not set; cannot locate gcloud ADC credentials");
+	}
+	string adc_path = string(home) + "/.config/gcloud/application_default_credentials.json";
+
+	// 2. Read it
+	LocalFileSystem fs;
+	auto handle = fs.OpenFile(adc_path, {FileOpenFlags::FILE_FLAGS_READ});
+	auto file_size = fs.GetFileSize(*handle);
+	string adc(file_size, '\0');
+	fs.Read(*handle, (void *)adc.data(), file_size);
+
+	// 3. Extract user-credential fields
+	string client_id = SpikeExtractJsonString(adc, "client_id");
+	string client_secret = SpikeExtractJsonString(adc, "client_secret");
+	string refresh_token = SpikeExtractJsonString(adc, "refresh_token");
+
+	// 4. POST refresh-token exchange
+	string body = "client_id=" + SpikeUrlEncode(client_id) +
+	              "&client_secret=" + SpikeUrlEncode(client_secret) +
+	              "&refresh_token=" + SpikeUrlEncode(refresh_token) +
+	              "&grant_type=refresh_token";
+
+	string url = "https://oauth2.googleapis.com/token";
+	auto &http_util = HTTPUtil::Get(*context.db);
+	auto http_params = http_util.InitializeParameters(context, url);
+	HTTPHeaders headers;
+	headers["Content-Type"] = "application/x-www-form-urlencoded";
+	PostRequestInfo post_request(url, headers, *http_params, const_data_ptr_cast(body.data()), body.size());
+	auto response = http_util.Request(post_request);
+
+	if (!response->Success()) {
+		throw IOException("Google token endpoint returned status %d: %s", (int)response->status,
+		                  post_request.buffer_out);
+	}
+
+	// 5. Extract access_token
+	return SpikeExtractJsonString(post_request.buffer_out, "access_token");
+}
+
+unique_ptr<BaseSecret> CreateS3SecretFunctions::CreateGCSSecretFromCredentialChain(ClientContext &context,
+                                                                                   CreateSecretInput &input) {
+	// SPIKE: tries SPIKE_GCS_TOKEN env override first (debugging convenience),
+	// then falls back to the gcloud user-credentials ADC source. A full
+	// implementation will walk the complete Google ADC chain (env-var SA key,
+	// gcloud user, GCE metadata server, workload identity).
+	auto scope = input.scope;
+	if (scope.empty()) {
+		scope.push_back("gcs://");
+		scope.push_back("gs://");
+	}
+
+	string token;
+	const char *env_token = std::getenv("SPIKE_GCS_TOKEN");
+	if (env_token) {
+		token = env_token;
+	} else {
+		token = SpikeFetchAccessTokenFromGcloudUserCreds(context);
+	}
+
+	auto secret = make_uniq<KeyValueSecret>(scope, input.type, input.provider, input.name);
+	secret->secret_map["bearer_token"] = token;
+	secret->redact_keys = {"bearer_token"};
+	return std::move(secret);
 }
 
